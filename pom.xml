<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>dev.example</groupId>
  <artifactId>grpc-springboot2-auth</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>gRPC Spring Boot 2 mutual TLS</name>

  <modules>
    <module>api</module>
    <module>server</module>
    <module>client</module>
  </modules>

  <properties>
    <!-- Lowest Java that Spring Boot 2.x runs on. -->
    <java.version>1.8</java.version>
    <grpc.version>1.58.0</grpc.version>
    <protobuf.version>3.24.0</protobuf.version>
    <grpc-spring-boot.version>2.15.0.RELEASE</grpc-spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.example</groupId>
        <artifactId>grpc-hello-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
