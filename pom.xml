<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>dev.example</groupId>
  <artifactId>grpc-springboot2-auth</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>gRPC mutual TLS and bearer tokens</name>

  <modules>
    <module>api</module>
    <module>server</module>
    <module>client</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <spring-grpc.version>1.1.1</spring-grpc.version>
    <!-- Same versions that spring-grpc-dependencies 1.0.3 manages; protoc and its gRPC plugin must match them. -->
    <grpc.version>1.77.1</grpc.version>
    <protobuf-java.version>4.33.4</protobuf-java.version>
    <protobuf-maven-plugin.version>5.1.10</protobuf-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.grpc</groupId>
        <artifactId>spring-grpc-dependencies</artifactId>
        <version>${spring-grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.example</groupId>
        <artifactId>grpc-hello-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
